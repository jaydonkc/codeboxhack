{
  "name": "elsewhere",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "^5.2.0",
    "@types/leaflet": "^1.9.22",
    "expo": "~57.0.20",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.2",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.2",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:demo": "sh scripts/start-demo.sh",
    "android": "expo run:android",
    "ios": "sh scripts/ios-local.sh",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/core/*.test.ts server/*.test.ts",
    "export:web": "expo export --platform web",
    "export:native": "expo export --platform ios --platform android",
    "server": "node --env-file-if-exists=.env.server.local --import tsx server/index.ts",
    "android:local": "sh scripts/android-local.sh"
  },
  "private": true
