{
  "expo": {
    "name": "Elsewhere",
    "slug": "elsewhere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jaydon.elsewhere"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18271f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jaydon.elsewhere"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Elsewhere to find experiences near you."
        }
      ]
    ],
    "scheme": "elsewhere",
    "description": "Find your kind of good day in San Luis Obispo.",
    "backgroundColor": "#18271f"
  }
}
